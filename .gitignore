# The eight NHANES XPT files (four cycles) are public domain but large;
# regenerate with download_data.py
data/*.XPT
data/*.xpt

# models/, model_info.json and the input-guard log are all regenerated by
# src/anemia_app.py
models/*.pkl
models/*.json

# fig1..fig10 are regenerated by src/figures.py. app_overview.png is regenerated
# by src/anemia_app.py menu option 3, not by the pipeline, which is why the run
# manifest names it under artefacts_not_hashed instead of hashing it.
figures/*.png
figures/*.pdf

# Superseded manuscript-only flowchart sources.
figures/fig1_flowchart_clean.*
figures/fig1_flowchart_final.*
figures/fig1_workflow.*

# Representative result figures displayed in the README.
!figures/fig2_ladder.png
!figures/fig3_decomposition.png
!figures/fig9_contrasts.png
!figures/fig10_out_of_cycle.png

# results/ IS tracked on purpose - the JSON files are the paper's evidence
# and are small enough to commit. The exception is the run log, which is just
# the stdout of one machine's run; run_manifest.json is the part worth keeping.
# Both generations: run_all.py rotates run_all.log to run_all.prev.log so a
# failing run does not destroy the output of the last one that worked, and the
# previous generation is the same one-machine stdout as the current one.
results/run_all.log
results/run_all.prev.log

__pycache__/
*.pyc
.pytest_cache/
.coverage
coverage.json
htmlcov/
tmp/
.venv/
.DS_Store
